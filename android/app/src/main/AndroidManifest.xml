<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false">
        <provider android:name=".VelocityApkProvider" android:authorities="${applicationId}.velocity.apks" android:exported="false" android:grantUriPermissions="true" />
        <profileable android:shell="${velocityProfileable}" />
        <activity android:name=".GameActivity" android:exported="true" android:process=":game"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density" android:screenOrientation="userLandscape">
            <meta-data android:name="android.app.lib_name" android:value="nfsu2_android" />
        </activity>
        <activity android:name=".GpuProbeActivity" android:exported="false"
            android:process=":gpu_probe" android:screenOrientation="landscape" />
        <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
